<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared fallback nuget.config for target repos that don't provide their own
  .ralph/nuget.config. Behavior:

  - <clear/> forces PrivateFeed as the ONLY source. Direct api.nuget.org
    access typically fails behind corporate proxies (UntrustedRoot / reset by
    peer). All packages must come via the private feed, which proxies
    nuget.org internally.
  - PrivateFeed is auth'd with %PROGET_DOTNET_TOKEN% (set on the host, forwarded
    into the sidecar by ralph.sh:launch_sidecars).

  If a restore fails with `NU1301` / `UntrustedRoot` / connection reset from
  api.nuget.org, that means something bypassed this config. Fix the feed
  (mount / env var / config path); do NOT add CA certs to work around it.

  Target repos should prefer shipping their own .ralph/nuget.config (which
  ralph.sh mounts in preference to this file when present).
-->
<configuration>
  <packageSources>
    <clear />
    <!-- Private feed: set NUGET_PRIVATE_FEED_URL to your org's NuGet feed URL -->
    <add key="PrivateFeed" value="%NUGET_PRIVATE_FEED_URL%" />
  </packageSources>
  <packageSourceCredentials>
    <PrivateFeed>
      <add key="Username" value="api" />
      <add key="ClearTextPassword" value="%PROGET_DOTNET_TOKEN%" />
    </PrivateFeed>
  </packageSourceCredentials>
</configuration>
